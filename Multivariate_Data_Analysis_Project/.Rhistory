library(plotly)
data5_2 <- prcomp(data5_variables, scale. = TRUE)
raw_standardized_data <- as.data.frame(scale(data5_variables))
pca_scores_data <- pca_scores_data <- as.data.frame(pca_results$scores[, 1:3])
pca_scores <- as.data.frame(data5_2$x)
# 1. Extract the scores and city names from our existing PCA results
scores_df <- as.data.frame(pca_results$scores)
scores_df$city <- data5$city
# 2. Get the proportion of variance explained for axis labels
# This comes from the summary of our pca_results object
pca_summary <- summary(pca_results)
variance_explained <- pca_summary$sdev^2 / sum(pca_summary$sdev^2)
pc1_label <- paste0("PC1 (", round(variance_explained[1] * 100, 1), "%)")
pc2_label <- paste0("PC2 (", round(variance_explained[2] * 100, 1), "%)")
pc3_label <- paste0("PC3 (", round(variance_explained[3] * 100, 1), "%)")
# 3. Create the interactive 3D plot
plot_ly(data = scores_df,
x = ~Comp.1, y = ~Comp.2, z = ~Comp.3,
text = ~city, # Use city names for hover text
type = 'scatter3d',
mode = 'markers',
marker = list(size = 5, color = ~Comp.1, colorscale = 'Viridis', showscale = TRUE, colorbar = list(title = pc1_label))) %>%
layout(
title = "Interactive 3D PCA Scatter Plot of US Cities (Improved)",
scene = list(
xaxis = list(title = pc1_label),
yaxis = list(title = pc2_label),
zaxis = list(title = pc3_label)
)
)
#Load the libraries needed
library(tidyverse) #data manipulation
library(cluster) #clustering algorithms
library(factoextra) #clustering visualization
library(dendextend) #for comparing two dendograms
library(laGP) #squared Euclidean distance
library(metan) #clustering algorithms
library(tidygeocoder) # for geocoding
library(maps) # for map data
# We Scale the data to perform the euclidean distance.
data5_v <- scale(data5_variables)
# Eucledian distance.
dist_data5 <- dist(data5_v, method = "euclidean")
dist_data5
hc1_s <- agnes(dist_data5, method = "single")
hc1_s$merge
hc1_s$order
hc1_s$ac
#Cophenetic Coefficient
clust_single_s <- hclust(dist_data5, method="single")
#Cophenetic matrix (delta matrix - obtained based on the dendogram)
coph_1_s <- cophenetic(clust_single_s)
#Cophenetic coefficient
cor(dist_data5, coph_1_s)
#Dendrogram
dend1_s <- as.dendrogram(hc1_s)
#labels(dend1_s) <- data5$city
order_in_dend <- order.dendrogram(dend1_s)
labels(dend1_s) <- data5$city[order_in_dend]
plot(dend1_s, main = "Single Linkage - standardized data - 2 clusters")
hc2_s <- agnes(dist_data5, method = "complete")
hc2_s$merge
hc2_s$order
hc2_s$ac
#Cophenetic Coefficient
clust_complete_s <- hclust(dist_data5, method="complete")
#Cophenetic matrix (delta matrix - obtained based on the dendogram)
coph_2_s <- cophenetic(clust_complete_s)
#Cophenetic coefficient
cor(dist_data5, coph_2_s)
#Dendrogram
dend2_s <- as.dendrogram(hc2_s)
#labels(dend1_s) <- data5$city
order_in_dend2 <- order.dendrogram(dend2_s)
labels(dend2_s) <- data5$city[order_in_dend2]
plot(dend2_s, main = "Complete Linkage - standardized data - 2 clusters")
abline(h = 8, col = "red", lwd = 2)
rect.hclust(hc2_s, k=2, border = 2:4)
library(ggplot2)
library(dplyr)
library(ggforce)
k <- 2
clusters <- cutree(hc2_s, k = k)
df <- data.frame(
city = data5$city,
cluster = factor(clusters)
)
circles <- data.frame(
cluster = factor(c(1,2)),
x0 = c(-1, 1),
y0 = c(0, 0),
r = c(1.8, 1.8)
)
set.seed(123)
df <- df %>%
left_join(circles, by = "cluster") %>%
rowwise() %>%
mutate(
x = x0 + runif(1, -0.9, 0.9),
y = y0 + runif(1, -0.9, 0.9)
)
ggplot() +
geom_circle(data = circles,
aes(x0 = x0, y0 = y0, r = r, fill = cluster),
alpha = 0.2, color = "black", linewidth = 1.2) +
geom_text(data = df, aes(x = x, y = y, label = city), size = 5) +
coord_fixed() +
theme_void() +
scale_fill_manual(values = c("#66c2a5", "#fc8d62")) +
ggtitle("Cities Distributed By Clusters")
