library(FactoMineR)
library(factoextra)
library(ggplot2)
library(ggrepel)
# Prepare data (exclude city column)
pca_input <- data5[, -which(names(data5) == "city")]
# Run PCA
pca_result <- PCA(pca_input, scale.unit = TRUE, graph = FALSE)
# Scores (coordinates of cities)
scores <- as.data.frame(pca_result$ind$coord)
scores$city <- data5$city
# Loadings (variable contributions)
loadings <- as.data.frame(pca_result$var$coord)
loadings$var <- rownames(loadings)
scale_factor <- 3  # You can adjust this (try 2–5 depending on spread)
loadings_scaled <- loadings
loadings_scaled$Dim.1 <- loadings$Dim.1 * scale_factor
loadings_scaled$Dim.2 <- loadings$Dim.2 * scale_factor
ggplot(scores, aes(x = Dim.1, y = Dim.2)) +
geom_point(color = "steelblue", size = 3) +
geom_text_repel(aes(label = city), size = 3, max.overlaps = 30) +
# Scaled variable vectors
geom_segment(data = loadings_scaled,
aes(x = 0, y = 0, xend = Dim.1, yend = Dim.2),
arrow = arrow(length = unit(0.25, "cm")),
color = "red", size = 1) +
geom_text_repel(data = loadings_scaled,
aes(x = Dim.1, y = Dim.2, label = var),
color = "red", size = 4) +
labs(title = "PCA Biplot of US Cities",
subtitle = "PC1: Industrialization/Urbanization, PC2: Climate Gradient",
x = paste0("PC1 (", round(pca_result$eig[1,2], 2), "%)"),
y = paste0("PC2 (", round(pca_result$eig[2,2], 2), "%)")) +
theme_classic(base_size = 14)
ggsave("plots/biplot_pc1_pc2_plot.png", width = 8, height = 5, dpi = 300)
aes(x = Dim.2, y = Dim.3)   # for PC2 vs PC3
aes(x = Dim.1, y = Dim.3)   # for PC1 vs PC3
