# Assuming 'pca_scores' are your 3 PC scores
# and 'hc_complete_pca' is your hclust object from Complete Linkage
#
# The fviz_nbclust function can take the original data and apply
# the clustering for you for a range of k.
library(factoextra)
elbow_plot_raw <- fviz_nbclust(raw_standardized_data,
FUNcluster = function(x, k) hcut(x, k, hc_method = "complete"),
method = "wss")
elbow_plot_pca <- fviz_nbclust(pca_scores_data,
FUNcluster = function(x, k) hcut(x, k, hc_method = "complete"),
method = "wss")
# 2. Extract and combine
data_elbow_pca <- elbow_plot_pca$data
data_elbow_raw <- elbow_plot_raw$data
data_elbow_pca$Approach <- "Robust (PCA)"
data_elbow_raw$Approach <- "Standarized (Raw)"
combined_elbow_data <- rbind(data_elbow_pca, data_elbow_raw)
# 3. Create superior comparison plot
