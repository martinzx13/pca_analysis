library(factoextra)
# Gap Statistic for PCA scores
set.seed(123)  # reproducibility
fviz_nbclust(
pca_scores2[, -1],   # exclude the city column, keep only numeric PCs
FUNcluster = function(x, k) hcut(x, k, hc_method = "complete"),
method = "gap_stat",
nboot = 50
) +
labs(
title = "Gap Statistic for PCA-based Clustering",
subtitle = "Hierarchical clustering with complete linkage",
x = "Number of clusters (k)",
y = "Gap Statistic"
) +
theme_minimal(base_size = 14)
gap_stat <- clusGap(data5_v[, -1],
FUN = function(x, k) hcut(x, k, hc_method = "complete"),
K.max = 10, B = 50)
fviz_gap_stat(gap_stat)
