# packages
library(cluster)     # agnes
library(dendextend)  # ladderize, set(..., "labels_cex")
# Ensure PCA scores exist and select first 3 PCs (adjust ncomp if needed)
if (!exists("pca_scores")) {
stop("pca_scores not found. Run PCA and create 'pca_scores' before this chunk.")
}
ncomp <- min(3, ncol(pca_scores))
pca_cluster <- as.data.frame(pca_scores)[, 1:ncomp, drop = FALSE]
# compute agglomerative clusterings (single, complete, ward) on PCA scores
hc_single_pca   <- agnes(pca_cluster, method = "single")
hc_complete_pca <- agnes(pca_cluster, method = "complete")
hc_ward_pca     <- agnes(pca_cluster, method = "ward")   # agnes "ward"
# convert to hclust for convenience and create dendrograms
hclust_single_pca   <- as.hclust(hc_single_pca)
hclust_complete_pca <- as.hclust(hc_complete_pca)
hclust_ward_pca     <- as.hclust(hc_ward_pca)
dend_single_pca   <- as.dendrogram(hclust_single_pca)   %>% ladderize()
dend_complete_pca <- as.dendrogram(hclust_complete_pca) %>% ladderize()
dend_ward_pca     <- as.dendrogram(hclust_ward_pca)     %>% ladderize()
# set labels in plotting order and reduce label size
if (!is.null(data5$city)) {
labels(dend_single_pca)   <- data5$city[order.dendrogram(dend_single_pca)]
labels(dend_complete_pca) <- data5$city[order.dendrogram(dend_complete_pca)]
labels(dend_ward_pca)     <- data5$city[order.dendrogram(dend_ward_pca)]
} else {
labels(dend_single_pca)   <- rownames(pca_cluster)[order.dendrogram(dend_single_pca)]
labels(dend_complete_pca) <- rownames(pca_cluster)[order.dendrogram(dend_complete_pca)]
labels(dend_ward_pca)     <- rownames(pca_cluster)[order.dendrogram(dend_ward_pca)]
}
# smaller label text for all dendrograms
dend_single_pca   <- set(dend_single_pca,   "labels_cex", 0.55)
dend_complete_pca <- set(dend_complete_pca, "labels_cex", 0.55)
dend_ward_pca     <- set(dend_ward_pca,     "labels_cex", 0.55)
plot_three_pca_dendros <- function(d1, d2, d3) {
op <- par(mfrow = c(1, 3), mar = c(8, 4, 3, 1) + 0.1)  # extra bottom margin for labels
plot(d1, main = "Single linkage (PCA scores)", ylab = "Height",
edgePar = list(col = "darkgray", lwd = 1))
plot(d2, main = "Complete linkage (PCA scores)", ylab = "Height",
edgePar = list(col = "darkgray", lwd = 1))
plot(d3, main = "Ward linkage (PCA scores)", ylab = "Height",
edgePar = list(col = "darkgray", lwd = 1))
par(op)
}
# Display in the knitted report
plot_three_pca_dendros(dend_single_pca, dend_complete_pca, dend_ward_pca)
# Save identical high-resolution PNG to plots/ (re-run the same plotting code inside png())
if (!dir.exists("plots")) dir.create("plots")
png(filename = "plots/pca_dendrograms_comparison.png", width = 2400, height = 1000, res = 300)
plot_three_pca_dendros(dend_single_pca, dend_complete_pca, dend_ward_pca)
dev.off()
# 1. Generate data for Silhouette method
sil_plot_pca <- fviz_nbclust(pca_scores_data, FUNcluster = function(x, k) hcut(x, k, hc_method = "complete"), method = "silhouette")
sil_plot_raw <- fviz_nbclust(raw_standardized_data, FUNcluster = function(x, k) hcut(x, k, hc_method =  "complete"), method = "silhouette")
# 2. Extract and combine
data_sil_pca <- sil_plot_pca$data
data_sil_raw <- sil_plot_raw$data
data_sil_pca$Approach <- "Robust (PCA)"
data_sil_raw$Approach <- "Standarized (Raw)"
combined_sil_data <- rbind(data_sil_pca, data_sil_raw)
# 3. Create superior comparison plot
ggplot(combined_sil_data, aes(x = clusters, y = y, group = Approach, color = Approach)) +
geom_line(linewidth = 1.2) +
geom_point(size = 3) +
labs(
title = "Comparison of Average Silhouette Scores",
subtitle = "Robust (PCA) vs. Standarized (Raw) Approach",
x = "Number of Clusters (k)",
y = "Average Silhouette Width"
) +
theme_minimal(base_size = 14) +
scale_color_manual(values = c("Robust (PCA)" = "blue", "Standarized (Raw)" = "red"))
# GOAL: Geocode cities and create a map of the US with cities colored by cluster.
print("Attempting to geocode cities. This may take a moment...")
geocoded_data <- tryCatch({
data_with_clusters %>%
geocode(city = city, method = 'osm', verbose = FALSE)
}, error = function(e) {
warning(paste("Geocoding failed with an error:", e$message), immediate. = TRUE)
return(NULL) # Return NULL on error
})
if (!is.null(geocoded_data) && all(c("lat", "long") %in% colnames(geocoded_data)) && sum(!is.na(geocoded_data$lat)) > 0) {
print("Geocoding successful. Generating map...")
us_map <- map_data("state")
ggplot() +
geom_polygon(data = us_map, aes(x = long, y = lat, group = group), fill = "grey80", color = "white") +
geom_point(data = geocoded_data, aes(x = long, y = lat, color = as.factor(cluster)), size = 3, alpha = 0.8) +
coord_map("albers", lat0 = 39, lat1 = 45) +
labs(
title = "Geographic Distribution of City Clusters",
subtitle = "Cities grouped by pollution and demographic profiles",
color = "City Cluster"
) +
theme_minimal() +
theme(
axis.title = element_blank(),
axis.text = element_blank(),
axis.ticks = element_blank(),
panel.grid = element_blank()
)
} else {
print("Geocoding failed or returned no valid coordinates. Cannot generate map.")
}
